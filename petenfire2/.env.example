# =============================================================================
# PetenFire — Variables de entorno (ejemplo)
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA commitees `.env` al repositorio.
# =============================================================================

# --- NASA Earthdata (FIRMS, MODIS, SRTM) -------------------------------------
EARTHDATA_USER=tu_usuario
EARTHDATA_PASS=tu_password
FIRMS_MAP_KEY=tu_firms_map_key

# --- Copernicus Climate Data Store (ERA5) ------------------------------------
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=tu_uid:tu_api_key

# --- Copernicus Open Access Hub / Sentinel Hub -------------------------------
COPERNICUS_USER=tu_usuario
COPERNICUS_PASS=tu_password

# --- Google Earth Engine -----------------------------------------------------
GEE_SERVICE_ACCOUNT=tu_service_account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./credentials/gee-key.json

# --- Microsoft Planetary Computer (opcional) ---------------------------------
PC_SDK_SUBSCRIPTION_KEY=tu_subscription_key

# --- Configuración del proyecto ----------------------------------------------
PROJECT_ROOT=.
DATA_DIR=./data
LOG_LEVEL=INFO
RANDOM_SEED=42

# --- Área de estudio ---------------------------------------------------------
# Bounding box del Petén (lon_min, lat_min, lon_max, lat_max)
PETEN_BBOX=-91.45,15.88,-89.14,17.82
GRID_RESOLUTION_KM=1
